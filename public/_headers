# Cloudflare Pages headers.
#
# Cloudflare copies everything in `public/` into the build output, so this file
# lands at the site root and is read automatically — no dashboard configuration
# needed for these rules.
#
# The split mirrors vercel.json: hashed assets can be cached forever because
# their name changes when their content does, while index.html must never be
# cached or a deploy would keep serving the old bundle to anyone who had the page
# open.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin