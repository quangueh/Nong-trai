# Dependencies
node_modules

# Build output
dist
artifacts/technical-tests/

# Screenshots produced by the verification harness (tools/shot*.ts).
# Regenerated on demand and about 35 MB, so they are output rather than source.
shots

# Working screenshots from UI passes — same category as shots/.
_view/

# Environment — the game is client-side, but never commit one by accident.
.env
.env.local
.env.*.local

# Vercel
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# One-off migration and scratch scripts.
#
# These edit the source or probe a screen once, then are done. Committing them adds noise
# to a repository whose history is already long, and every one of them encodes a
# decision that the code it wrote already records.
tools/patch-*.mjs
tools/fix-*.mjs
tools/rm-*.mjs
tools/_scratch-*.ts
tools/_resnap.ts
tools/_shots2.ts
